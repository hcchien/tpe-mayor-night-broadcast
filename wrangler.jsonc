{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tpe-mayor-night-broadcast",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tpe-mayor-night-broadcast",
      "database_id": "6b1dd427-7644-46ca-b7ce-d6e05dccf74c",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1826301001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "READ_LIMITER",
      "namespace_id": "1826301002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 19 * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_ORIGIN": "https://tpe-mayor.thecocoa.cool",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGUE62du4GLrFddS",
    "GOOGLE_CLIENT_ID": "448719938843-chctk3c8ur7ftvsnb3ebcjtdcq12hiri.apps.googleusercontent.com",
    "REGISTRATION_OPEN": "false",
    "DAILY_SUBMISSION_LIMIT": "200",
    "EVENT_LABEL": "台北市長選前之夜",
    "EVENT_TIME": "活動時間與直播資訊將由主辦單位公布",
    "LIVESTREAM_URL": "",
    "CONTACT_EMAIL": "",
    "ORGANIZER_NAME": "",
    "PRIVACY_DELETE_AFTER": ""
  }
}
