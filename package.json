{
  "name": "tpe-mayor-night-broadcast",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/preflight.mjs && wrangler deploy && node scripts/ensure-pages.mjs && npm run deploy:pages",
    "deploy:pages": "wrangler pages deploy --config pages/wrangler.jsonc --branch main"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "jose": "6.2.10",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260914.1",
    "@playwright/test": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "wrangler": "4.131.1"
  }
}
